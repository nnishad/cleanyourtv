<?xml version="1.0" encoding="utf-8"?>
<!-- A Keep watching card: the show's picture at the size and corners of a dock tile (KeepWatching sizes it to the
     tile under it), the app's icon in a corner and the progress along the bottom. The title is on Home's context line
     while the card is focused; it is written on the card only when the app gave no picture. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="124dp"
    android:layout_height="70dp"
    android:background="@color/glass_base"
    android:focusable="true">

    <ImageView
        android:id="@+id/watchThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- A little dark under the progress bar and the title, so both read on any picture. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_gravity="bottom"
        android:background="@drawable/watch_card_scrim" />

    <ImageView
        android:id="@+id/watchAppIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/watchTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="11dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_medium"
        android:maxLines="2"
        android:shadowColor="@color/text_shadow"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#FFFFFFFF"
        android:textSize="@dimen/type_caption" />

    <ProgressBar
        android:id="@+id/watchProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="5dp"
        android:max="100"
        android:progressBackgroundTint="#59FFFFFF"
        android:progressBackgroundTintMode="src_in"
        android:progressTint="@color/accent" />
</FrameLayout>
