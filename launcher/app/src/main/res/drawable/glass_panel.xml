<?xml version="1.0" encoding="utf-8"?>
<!-- A window over Home (the Inputs list, the gear and tile menus, hints): the dock band's glass and thin rim over
     a dark base dense enough for white text to read over a bright picture or over the app tiles themselves. No blur:
     not affordable here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F5141A24" android:endColor="#FA0C1016" />
            <corners android:radius="@dimen/radius_l" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#24FFFFFF" android:endColor="#0DFFFFFF" />
            <corners android:radius="@dimen/radius_l" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#47FFFFFF" />
            <corners android:radius="@dimen/radius_l" />
        </shape>
    </item>
</layer-list>
