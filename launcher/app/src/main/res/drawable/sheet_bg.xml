<?xml version="1.0" encoding="utf-8"?>
<!-- The settings sheet (design/REVAMP-PLAN.md 3.4): dark glass on the right, large rounded corners on its open side,
     a thin rim. Home stays visible to its left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sheet_scrim" />
            <corners android:topLeftRadius="@dimen/radius_l" android:bottomLeftRadius="@dimen/radius_l" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/glass_rest_rim" />
            <corners android:topLeftRadius="@dimen/radius_l" android:bottomLeftRadius="@dimen/radius_l" />
        </shape>
    </item>
</layer-list>
