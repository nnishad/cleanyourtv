<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings choices (tokens.xml): focus glass when focused, the accent rim when chosen, rest glass otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="@integer/motion_fast" android:exitFadeDuration="@integer/motion_fast">
    <item android:state_focused="true" android:drawable="@drawable/glass_focus" />
    <item android:state_selected="true">
        <layer-list>
            <item android:drawable="@drawable/glass_rest" />
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="@dimen/rim_width" android:color="@color/accent" />
                    <corners android:radius="@dimen/radius_m" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/glass_rest" />
</selector>
