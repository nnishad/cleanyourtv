<?xml version="1.0" encoding="utf-8"?>
<!-- Top buttons (tokens.xml): the shared glass, round. Focused: glass_focus colours; reorder mode: accent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="@integer/motion_fast" android:exitFadeDuration="@integer/motion_fast">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/glass_base" /><corners android:radius="24dp" /></shape></item>
            <item><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="@color/glass_focus_top" android:endColor="@color/glass_focus_bottom" />
                <stroke android:width="@dimen/rim_width" android:color="@color/glass_focus_rim" />
                <corners android:radius="24dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="@dimen/rim_width" android:color="@color/accent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/glass_base" /><corners android:radius="24dp" /></shape></item>
            <item><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="@color/glass_rest_top" android:endColor="@color/glass_rest_bottom" />
                <stroke android:width="1dp" android:color="@color/glass_rest_rim" />
                <corners android:radius="24dp" /></shape></item>
        </layer-list>
    </item>
</selector>
